// Basic POD Settings
{
  "settings" : {
    "description" : "North Atlantic Ocean diagnostics",
    "driver" : "natl_driver.py",
    "long_name" : "North Atlantic diagnostic in Subtropical to Subpolar latitudes",
    "convention": "CMIP",
    "runtime_requirements": {
        "python3": ["matplotlib", "xarray"]
    }
  },
// Variable Coordinates
  "dimensions" : {
    "lat": {
             "standard_name": "latitude",
             "units": "degrees_north",
             "axis": "Y"
           },
    "lon": {
             "standard_name": "longitude",
             "units": "degrees_east",
             "axis": "X"
           },
    "lev": {
             "standard_name": "depth",
             "units": "centimeters",
             "axis": "Z",
             "positive": "down"
            },
    "time": {"standard_name": "time"}
  },

// Variables
  "varlist" : {
    "tos": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lat", "lon"],
      "standard_name" : "sea_surface_temperature",
      "units": "degC"
    },
   // either wfo or vsf must be available in catalogue
   "wfo": {
     "frequency" : "month",
     "realm": "ocean",
     "dimensions": ["time", "lat", "lon"],
     "standard_name" : "water_flux_into_sea_water",
     "units": "kg m-2 s-1",
     "requirement": "optional"
    },
  //  "vsf": {
  //    "frequency" : "month",
  //    "realm": "ocean",
  //    "dimensions": ["time", "lat", "lon"],
  //    "standard_name" : "virtual_salt_flux_into_sea_water",
  //    "units": "kg m-2 s-1",
  //    "requirement": "optional"
  //  },
    "hfds": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lat", "lon"],
      "standard_name" : "surface_downward_heat_flux_in_sea_water",
      "units": "W m-2"
    },
    "so": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "lat", "lon"],
      "standard_name" : "sea_water_salinity",
      "units": "psu"
    },
    "thetao": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "lat", "lon"],
      "standard_name" : "sea_water_potential_temperature",
      "units": "degC"
    },
    // either volcello or thkcello must be available in catalogue
    // "volcello": {
    //   "realm": "ocean",
    //   "dimensions": ["lev", "lat", "lon"],
    //   "standard_name" : "ocean_volume",
    //   "units": "m3",
    //   "requirement": "optional"
    // },
    "thkcello": {
      "realm": "ocean",
      "dimensions": ["lev"],
      "standard_name" : "cell_thickness",
      "units": "m",
      "requirement": "optional"
    },
    "areacello": {
      "realm": "ocean",
      "dimensions": ["lat", "lon"],
      "standard_name" : "cell_area",
      "units": "m2"
    }

  }
}

